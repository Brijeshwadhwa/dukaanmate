# DukaanMate Backend — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to Git

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get from: https://supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # NEVER expose to frontend
SUPABASE_JWT_SECRET=your-jwt-secret-here                # Settings → API → JWT Secret

# ── Google Gemini (OPTIONAL) ─────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# If empty or missing, the app uses rule-based fallbacks. All features still work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# ── App Config ───────────────────────────────────────────────────────────────
# In production, set this to your Vercel frontend URL (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
APP_ENV=development  # "development" or "production"

# Maximum length of user question to prevent abuse (characters)
MAX_QUESTION_LENGTH=500

